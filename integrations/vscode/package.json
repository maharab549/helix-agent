{
  "name": "helix-agent-vscode",
  "displayName": "Helix Agent",
  "description": "Use Helix Agent from VS Code with chat and coding commands.",
  "version": "0.1.3",
  "publisher": "helix-agent",
  "license": "MIT",
  "author": {
    "name": "Helix Agent Contributors"
  },
  "homepage": "https://github.com/maharab549/helix-agent",
  "repository": {
    "type": "git",
    "url": "https://github.com/maharab549/helix-agent.git",
    "directory": "integrations/vscode"
  },
  "bugs": {
    "url": "https://github.com/maharab549/helix-agent/issues"
  },
  "keywords": [
    "helix",
    "agent",
    "ai",
    "chat",
    "coding agent",
    "copilot",
    "cli"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "galleryBanner": {
    "color": "#111827",
    "theme": "dark"
  },
  "badges": [
    {
      "url": "https://github.com/maharab549/helix-agent/actions/workflows/ci.yml/badge.svg",
      "href": "https://github.com/maharab549/helix-agent/actions/workflows/ci.yml",
      "description": "CI"
    }
  ],
  "scripts": {
    "check": "node --check extension.js",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.2"
  },
  "activationEvents": [
    "onChatParticipant:helix.agent",
    "onCommand:helix.ask",
    "onCommand:helix.fixSelection",
    "onCommand:helix.rewriteSelection",
    "onCommand:helix.reviewWorkspace",
    "onCommand:helix.explainFile",
    "onCommand:helix.learnStatus",
    "onCommand:helix.setupLlm",
    "onCommand:helix.setupDetails",
    "onCommand:helix.openChat",
    "onCommand:helix.openRightPanel",
    "onView:helix.panel",
    "onLanguageModelTool:helix_workspace"
  ],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "Helix Agent",
      "properties": {
        "helix.executable": {
          "type": "string",
          "default": "helix",
          "description": "Path to the Helix executable."
        },
        "helix.provider": {
          "type": "string",
          "default": "",
          "description": "Optional Helix provider override."
        },
        "helix.model": {
          "type": "string",
          "default": "",
          "description": "Optional Helix model override."
        },
        "helix.openaiBaseUrl": {
          "type": "string",
          "default": "",
          "description": "Optional OpenAI chat completions URL. Leave empty to use Helix's default or OPENAI_BASE_URL."
        },
        "helix.openrouterBaseUrl": {
          "type": "string",
          "default": "",
          "description": "Optional OpenRouter chat completions URL. Leave empty to use Helix's default or OPENROUTER_BASE_URL."
        },
        "helix.ollamaBaseUrl": {
          "type": "string",
          "default": "",
          "description": "Optional Ollama chat URL. Leave empty to use Helix's default or OLLAMA_BASE_URL."
        },
        "helix.customBaseUrl": {
          "type": "string",
          "default": "",
          "description": "Optional custom OpenAI-compatible chat completions URL. Leave empty to use Helix's default or HELIX_BASE_URL."
        }
      }
    },
    "commands": [
      {
        "command": "helix.ask",
        "title": "Helix: Ask"
      },
      {
        "command": "helix.fixSelection",
        "title": "Helix: Fix Selection"
      },
      {
        "command": "helix.rewriteSelection",
        "title": "Helix: Rewrite Selection"
      },
      {
        "command": "helix.reviewWorkspace",
        "title": "Helix: Review Workspace"
      },
      {
        "command": "helix.explainFile",
        "title": "Helix: Explain Current File"
      },
      {
        "command": "helix.learnStatus",
        "title": "Helix: Learning Status"
      },
      {
        "command": "helix.setupLlm",
        "title": "Helix: Setup LLM / Login"
      },
      {
        "command": "helix.setupDetails",
        "title": "Helix: Setup Details"
      },
      {
        "command": "helix.openChat",
        "title": "Helix: Open Chat"
      },
      {
        "command": "helix.openRightPanel",
        "title": "Helix: Open Right Side Panel"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "helix",
          "title": "Helix",
          "icon": "media/helix.svg"
        }
      ]
    },
    "views": {
      "helix": [
        {
          "id": "helix.panel",
          "name": "Helix Agent",
          "icon": "media/helix.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "helix.panel",
        "contents": "Run Helix from VS Code.\n[Setup LLM / Login](command:helix.setupLlm)\n[Setup Details](command:helix.setupDetails)\n[Open Right Side Panel](command:helix.openRightPanel)\n[Ask Helix](command:helix.ask)\n[Review Workspace](command:helix.reviewWorkspace)\n[Open Chat](command:helix.openChat)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "helix.openRightPanel",
          "when": "view == helix.panel",
          "group": "navigation@0"
        },
        {
          "command": "helix.setupLlm",
          "when": "view == helix.panel",
          "group": "navigation@1"
        },
        {
          "command": "helix.setupDetails",
          "when": "view == helix.panel",
          "group": "navigation@2"
        },
        {
          "command": "helix.ask",
          "when": "view == helix.panel",
          "group": "navigation@3"
        },
        {
          "command": "helix.reviewWorkspace",
          "when": "view == helix.panel",
          "group": "navigation@4"
        }
      ],
      "editor/context": [
        {
          "command": "helix.fixSelection",
          "when": "editorHasSelection",
          "group": "navigation@10"
        },
        {
          "command": "helix.rewriteSelection",
          "when": "editorHasSelection",
          "group": "navigation@11"
        },
        {
          "command": "helix.explainFile",
          "group": "navigation@12"
        }
      ]
    },
    "languageModelTools": [
      {
        "name": "helix_workspace",
        "displayName": "Helix Workspace",
        "toolReferenceName": "helix",
        "canBeReferencedInPrompt": true,
        "icon": "$(sparkle)",
        "userDescription": "Ask Helix Agent for workspace-aware coding help.",
        "modelDescription": "Runs the local Helix Agent CLI to answer questions about the current workspace, summarize the codebase, or infer test commands. Use when the user asks for Helix-specific context, repository maps, or coding-agent analysis.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "request": {
              "type": "string",
              "description": "The workspace question or instruction to send to Helix."
            },
            "mode": {
              "type": "string",
              "enum": ["ask", "map", "tests"],
              "default": "ask",
              "description": "Use map for a workspace summary, tests for inferred verification commands, or ask for a natural-language answer."
            }
          },
          "required": ["request"]
        }
      }
    ],
    "chatParticipants": [
      {
        "id": "helix.agent",
        "name": "helix",
        "fullName": "Helix Agent",
        "description": "Ask Helix about your workspace.",
        "isSticky": true,
        "commands": [
          {
            "name": "map",
            "description": "Map the current workspace"
          },
          {
            "name": "review",
            "description": "Review the current workspace"
          },
          {
            "name": "explain",
            "description": "Explain the active file"
          },
          {
            "name": "fix",
            "description": "Plan a code fix"
          },
          {
            "name": "learn",
            "description": "Show Helix learning status"
          },
          {
            "name": "setup",
            "description": "Set up or inspect Helix LLM provider login"
          }
        ],
        "disambiguation": [
          {
            "category": "workspace_coding",
            "description": "Questions about using Helix Agent to inspect, review, explain, improve, or learn from the current code workspace.",
            "examples": [
              "Ask Helix to review this workspace",
              "Use Helix to explain the active file",
              "What has Helix learned about this project?"
            ]
          }
        ]
      }
    ]
  }
}
